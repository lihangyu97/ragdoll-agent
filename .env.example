# OpenAI API Key（必填，中转站/官方均可）
OPENAI_API_KEY=sk-your-key-here

# 中转站地址（可选，OpenAI 兼容格式，必须以 /v1 结尾；不填则默认官方 https://api.openai.com/v1）
# 例：https://your-proxy.example.com/v1  （不要写成 https://your-proxy.example.com）
OPENAI_BASE_URL=https://your-proxy.example.com/v1

# 模型名（可选，默认 gpt-5.4-mini）
OPENAI_MODEL=deepseek-v4-flash

# 会话状态数据库文件路径（可选，默认 data/agent.db）
DB_PATH=data/agent.db

# === 系统工具（平台执行原语，CapabilityService）===
# 文件工具沙箱根目录（可选，默认 data/workspace）
SYSTEM_TOOLS_ROOT=data/workspace
# run_command 命令白名单前缀，逗号分隔（可选，留空 = 禁用 run_command）
# 例：git status,git diff,pnpm test
SYSTEM_TOOLS_COMMANDS=

# === 飞书（Lark）机器人 ===
# 飞书开放平台 → 开发者后台 → 你的应用 →「凭证与基础信息」
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 域名（可选，默认国内版飞书 feishu；国际版 Lark 套件填 lark）
LARK_DOMAIN=feishu
