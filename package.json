{
  "name": "ragdoll",
  "version": "0.1.0",
  "description": "学习用的 agent 项目（TypeScript）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:yml": "tsx scripts/start-yml.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "DB_PATH=:memory: tsx --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,jsx,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "ignore"
    }
  },
  "dependencies": {
    "@cordisjs/plugin-include": "1.0.4",
    "@cordisjs/plugin-loader": "1.0.0-rc.5",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^1.5.8",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "better-sqlite3": "^13.0.3",
    "cordis": "4.0.0-rc.8",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "langchain": "^1.5.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
